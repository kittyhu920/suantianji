---
// 静态页（关于、讲解、404）：把内容交给常驻的书桌（docs/DESIGN.md §19），摊在桌上的一张纸。
//   默认插槽    正文
//   left 插槽   题名（书名、标题）
//   hint 插槽   页脚的说明文字
//   foot 插槽   页脚右侧的链接或按钮
//   back        左上角小木牌的去向与字（不传就没有）
import Paper from './Paper.astro';
import PageData from './PageData.astro';

interface Props {
  title?: string;
  pageTitle?: string;
  description?: string;
  back?: { href: string; label: string; aria?: string };
}
const { title = '演算天机', pageTitle, description, back } = Astro.props;
---
<Paper title={pageTitle ?? title} description={description}>
  <PageData kind="doc" title={title} back={back}>
    <slot name="left" slot="left" />
    <slot />
    <slot name="hint" slot="hint" />
    <slot name="foot" slot="foot" />
  </PageData>
</Paper>
