---
// 纸面：宣纸、版框、朱丝栏；桌面上纸的外侧是"案"，留出区域给之后的字盘。
// 每个页面都包在它里面。zhu：为桌面的注栏留出位置（仪式页用）。
import './styles/fonts.css';
import './styles/base.css';
import './styles/layout.css';
import './styles/pages.css';

interface Props {
  title?: string;
  description?: string;
  zhu?: boolean;
}
const { title = '演算天机', description = '演算天机——一部收录多种民间算命法的书。第一卷是六十甲子签：一场被算法旁观的求签仪式。', zhu = false } = Astro.props;
---
<!doctype html>
<html lang="zh-CN">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<meta name="theme-color" content="#1A1C1E">
<title>{title}</title>
<meta name="description" content={description}>
<link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'%3E%3Crect width='32' height='32' rx='3' fill='%239E2A2B'/%3E%3Ctext x='16' y='23' font-size='20' text-anchor='middle' fill='%23F2E6CC' font-family='serif'%3E%E9%97%AE%3C/text%3E%3C/svg%3E">
</head>
<body>
  <!-- 共享图形：印章的毛边滤镜 -->
  <svg width="0" height="0" style="position:absolute" aria-hidden="true">
    <defs>
      <filter id="seal-rough" x="-6%" y="-6%" width="112%" height="112%">
        <feTurbulence type="fractalNoise" baseFrequency=".11" numOctaves="2" seed="8" result="n"/>
        <feDisplacementMap in="SourceGraphic" in2="n" scale="2.4" xChannelSelector="R" yChannelSelector="G"/>
      </filter>
    </defs>
  </svg>

  <main class="an">
    <div class="an-board" id="an-board" aria-hidden="true"></div>
    <div class="paper">
      <section class="huaxin" id="huaxin" class:list={{ 'has-zhu': zhu }}>
        <slot />
      </section>
    </div>
  </main>
</body>
</html>
