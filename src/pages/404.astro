---
import BookFrame from '../core/BookFrame.astro';
---
<BookFrame title="演算天机" pageTitle="此路不通 · 演算天机" back={{ href: '/', label: '书桌', aria: '回到书桌' }}>
  <div slot="left" class="doc-head lost-head">
    <span class="seal seal-lg" aria-hidden="true"><span>迷</span></span>
    <h1 id="l-h" class="lp-name">此路不通</h1>
  </div>
  <article class="screen screen-lost is-active" aria-labelledby="l-h">
    <p class="lost-text">你走到了一条我没算到的路上。<br>这里什么也没有。</p>
  </article>
  <span slot="hint">这一页什么也没有。点“回书桌”。</span>
  <a slot="foot" class="btn btn-primary lost-back" href="/">回书桌</a>
</BookFrame>
