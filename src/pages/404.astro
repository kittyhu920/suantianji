---
import Paper from '../core/Paper.astro';
---
<Paper title="此路不通 · 演算天机">
  <a class="corner-btn corner-home" href="/" aria-label="回到卷首">卷首</a>
  <div class="stage">
    <article class="screen screen-lost is-active" aria-labelledby="l-h">
      <span class="seal seal-lg" aria-hidden="true"><span>迷</span></span>
      <h1 id="l-h" class="h-brush">此路不通</h1>
      <p class="lost-text">你走到了一条我没算到的路上。<br>这里什么也没有。</p>
      <a class="btn btn-primary lost-back" href="/">回去看看目录</a>
    </article>
  </div>
</Paper>
