---
import BookFrame from '../core/BookFrame.astro';
import '../core/styles/toc.css';
import { juans } from '../juan/index.js';
---
<BookFrame title="演算天机" pageTitle="演算天机" description="演算天机——一部收录多种民间算命法的书。签、卦、卜、鸟、字、历，一卷一卷地开。" tou="示巫卜" kaijuan>
  <div slot="left" class="toc-head">
    <h1 id="toc-h" class="toc-title">演算天机</h1>
    <p class="toc-sub">你求签，我算你</p>
    <p class="toc-mulu" aria-hidden="true">目录</p>
  </div>

  <article class="screen screen-toc is-active" aria-labelledby="toc-h">
    <ol class="toc-list">
      {juans.map((j) => (
        <li class={`toc-item ${j.open ? 'is-open' : 'is-closed'}`}>
          {j.open ? (
            <a class="toc-entry" href={j.href} data-name={j.name} data-title={j.title} aria-label={`${j.name}卷：${j.title}，第${j.page}页。${j.intro}`}>
              <span class="toc-name">{j.name}</span>
              <span class="toc-full">{j.title}</span>
              <i class="toc-leader" aria-hidden="true"></i>
              <span class="toc-page">{j.page}</span>
              <span class="seal seal-sm toc-seal" aria-hidden="true"><span>入</span></span>
            </a>
          ) : (
            <div class="toc-entry" aria-disabled="true" aria-label={`${j.name}卷：${j.title}，未开卷`}>
              <span class="toc-name">{j.name}</span>
              <span class="toc-full">{j.title}</span>
              <i class="toc-leader" aria-hidden="true"></i>
              <span class="toc-page">{j.page}</span>
              <span class="toc-tag">未开卷</span>
            </div>
          )}
          <p class="toc-intro">{j.intro}</p>
        </li>
      ))}
    </ol>
  </article>

  <span slot="hint">点开了卷的卷名，翻进那一卷。灰色的几卷还没有开。</span>
  <p slot="foot" class="toc-foot">
    {juans.filter((j) => j.open && j.source).map((j) => <a class="about-link" href={j.source}>{j.name}卷源流</a>)}
    <a class="about-link" href="/about/">关于这件作品</a>
  </p>
</BookFrame>

<script>
  // 进入某一卷：从目录翻到那一卷的第一页，再跳转
  import { playLeaf, snapshot } from '../core/book/flip.js';

  const entries = document.querySelectorAll('a.toc-entry');
  entries.forEach((a) => {
    a.addEventListener('click', (e) => {
      if (e.defaultPrevented || e.button || e.metaKey || e.ctrlKey || e.shiftKey || e.altKey) return;
      if (matchMedia('(prefers-reduced-motion: reduce)').matches || document.hidden) return;
      const stage = document.getElementById('stage');
      const right = stage?.closest('.pg-right');
      const book = stage?.closest('.book');
      if (!stage || !right || !book) return;
      e.preventDefault();
      const single = matchMedia('(max-width: 959px)').matches;
      const r = right.getBoundingClientRect();
      // 背面：这一卷的扉页
      const back = document.createElement('div');
      back.className = 'pg-body';
      back.innerHTML = `<div class="lp lp-plain"><h2 class="lp-name">${a.dataset.name}</h2><p class="lp-sub">${a.dataset.title}</p></div>`;
      const href = a.getAttribute('href');
      const job = playLeaf(book, { front: snapshot(stage), back, page: { w: Math.round(r.width), h: Math.round(r.height) }, dir: 1, single, ms: single ? 800 : 1000, keep: true });
      document.documentElement.classList.add('is-leaving');
      job.done.then(() => { location.href = href; });
      setTimeout(() => { location.href = href; }, 2500);
    });
  });
</script>
