---
import Paper from '../core/Paper.astro';
import PageData from '../core/PageData.astro';
import { juans } from '../juan/index.js';
---
<Paper title="演算天机" description="演算天机——一部收录多种民间算命法的书。签、卦、卜、星、鸟、字、历，一卷一卷地开。">
  <PageData kind="home" title="演算天机">
    <span slot="hint">桌上每件器物是一卷，点一件就进那一卷。写着“未开卷”的几件还没有开（手机上往右滑，能看到它们）。</span>
    <p slot="foot" class="bot-links">
      {juans.filter((j) => j.open && j.source).map((j) => <a class="about-link" href={j.source}>{j.name}卷源流</a>)}
      <a class="about-link" href="/about/">关于这件作品</a>
    </p>
  </PageData>
</Paper>
