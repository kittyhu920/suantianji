---
import BookFrame from '../core/BookFrame.astro';
import '../core/styles/toc.css';
import { juans } from '../juan/index.js';
---
<BookFrame kind="toc" title="演算天机" pageTitle="演算天机" description="演算天机——一部收录多种民间算命法的书。签、卦、卜、鸟、字、历，一卷一卷地开。" tou="示巫卜">
  <div slot="left" class="toc-head">
    <h1 id="toc-h" class="toc-title">演算天机</h1>
    <p class="toc-sub">你求签，我算你</p>
    <p class="toc-mulu" aria-hidden="true">目录</p>
  </div>

  <article class="screen screen-toc is-active" aria-labelledby="toc-h">
    <ol class="toc-list">
      {juans.map((j) => (
        <li class={`toc-item ${j.open ? 'is-open' : 'is-closed'}`}>
          {j.open ? (
            <a class="toc-entry" href={j.href} data-name={j.name} data-title={j.title} aria-label={`${j.name}卷：${j.title}，第${j.page}页。${j.intro}`}>
              <span class="toc-name">{j.name}</span>
              <span class="toc-full">{j.title}</span>
              <i class="toc-leader" aria-hidden="true"></i>
              <span class="toc-page">{j.page}</span>
              <span class="seal seal-sm toc-seal" aria-hidden="true"><span>入</span></span>
            </a>
          ) : (
            <div class="toc-entry" aria-disabled="true" aria-label={`${j.name}卷：${j.title}，未开卷`}>
              <span class="toc-name">{j.name}</span>
              <span class="toc-full">{j.title}</span>
              <i class="toc-leader" aria-hidden="true"></i>
              <span class="toc-page">{j.page}</span>
              <span class="toc-tag">未开卷</span>
            </div>
          )}
          <p class="toc-intro">{j.intro}</p>
        </li>
      ))}
    </ol>
  </article>

  <span slot="hint">点开了卷的卷名，翻进那一卷。灰色的几卷还没有开。</span>
  <p slot="foot" class="toc-foot">
    {juans.filter((j) => j.open && j.source).map((j) => <a class="about-link" href={j.source}>{j.name}卷源流</a>)}
    <a class="about-link" href="/about/">关于这件作品</a>
  </p>
</BookFrame>
